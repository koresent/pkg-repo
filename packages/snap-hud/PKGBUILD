# Maintainer: koresent <https://github.com/koresent>
pkgname=snap-hud
pkgver=0.1.0.r3.g9d02f58
pkgrel=1
pkgdesc="Wayland window snapping HUD overlay"
arch=('x86_64')
url="https://github.com/koresent/snap-hud"
license=('GPL3')
depends=('glibc' 'gcc-libs' 'gtk4')
provides=('snap-hud')
conflicts=('snap-hud-bin' 'snap-hud-git')
source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/koresent/snap-hud/releases/download/nightly/snap-hud-x86_64-unknown-linux-gnu.tar.gz"
)
sha256sums=(
    'SKIP'
)

package() {
    install -Dm755 "${srcdir}/snap-hud" "${pkgdir}/usr/bin/snap-hud"
    if [[ -f "${srcdir}/LICENSE" ]]; then
        install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
