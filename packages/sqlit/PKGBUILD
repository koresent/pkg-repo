# Maintainer: koresent <https://github.com/koresent>
pkgname=sqlit
pkgver=1.6.5
pkgrel=1
pkgdesc="Terminal UI for SQL databases (PostgreSQL, MySQL, SQLite, DuckDB, ClickHouse, etc.)"
arch=('any')
url="https://github.com/Maxteabag/sqlit"
license=('MIT')
depends=('python')
makedepends=('git' 'uv')
provides=('sqlit' 'sqlit-tui')
conflicts=('sqlit-bin' 'sqlit-git' 'sqlit-tui')
source=(
    "${pkgname}::git+https://github.com/Maxteabag/sqlit.git#tag=v${pkgver}"
    "sqlit.desktop"
)
sha256sums=(
    'SKIP'
    'SKIP'
)

package() {
    cd "${srcdir}/${pkgname}"
    local venv_dir="${pkgdir}/usr/lib/${pkgname}"

    uv venv --python /usr/bin/python "${venv_dir}"
    uv pip install --python "${venv_dir}/bin/python" ".[all]"

    if [[ -d "${venv_dir}/bin" ]]; then
        sed -i "s|${pkgdir}||g" "${venv_dir}/bin/"* 2>/dev/null || true
    fi

    install -d "${pkgdir}/usr/bin"
    cat << 'EOF' > "${pkgdir}/usr/bin/sqlit"
#!/bin/sh
exec /usr/lib/sqlit/bin/sqlit "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/sqlit"
    ln -s sqlit "${pkgdir}/usr/bin/sqlit-tui"

    install -Dm644 "${srcdir}/sqlit.desktop" "${pkgdir}/usr/share/applications/sqlit.desktop"

    if [[ -f LICENSE ]]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
