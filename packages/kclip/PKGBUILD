# Maintainer: koresent <https://github.com/koresent>
pkgname=kclip
pkgver=0.1.0.r5.g1c0e8a6
pkgrel=1
pkgdesc="Wayland clipboard manager with rich TTY integration and history"
arch=('x86_64')
url="https://github.com/koresent/kclip"
license=('GPL3')
depends=('glibc' 'gcc-libs')
optdepends=(
    'wl-clipboard: Wayland clipboard command line utilities'
)
provides=('kclip')
conflicts=('kclip-bin' 'kclip-git')
source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/koresent/kclip/releases/download/nightly/kclip-x86_64-unknown-linux-gnu.tar.gz"
    "kclip.desktop"
    "kclip.service"
    "kclip.svg"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    install -Dm755 "${srcdir}/kclip" "${pkgdir}/usr/bin/kclip"
    install -Dm644 "${srcdir}/kclip.desktop" "${pkgdir}/usr/share/applications/kclip.desktop"
    install -Dm644 "${srcdir}/kclip.service" "${pkgdir}/usr/lib/systemd/user/kclip.service"
    install -Dm644 "${srcdir}/kclip.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/kclip.svg"
    if [[ -f "${srcdir}/LICENSE" ]]; then
        install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
