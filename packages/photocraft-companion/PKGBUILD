# Maintainer: koresent <https://github.com/koresent>
pkgname=photocraft-companion
pkgver=2.2.6
pkgrel=1
pkgdesc="AI-powered companion overlay and plugin ecosystem for PhotoCraft graphics editor (CUDA GPU accelerated)"
arch=('x86_64')
url="https://github.com/kobaltgit/photocraft-companion"
license=('MIT')
depends=(
    'cairo'
    'cuda'
    'cudnn'
    'gcc-libs'
    'gdk-pixbuf2'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'pango'
)
makedepends=(
    'cargo'
)
optdepends=(
    'photocraft-bin: PhotoCraft graphics editor'
    'wl-clipboard: Wayland clipboard support'
    'xclip: X11 clipboard support'
)
provides=('photocraft-companion')
conflicts=('photocraft-companion-bin' 'photocraft-companion-git')
options=('!lto' '!debug')
source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/kobaltgit/photocraft-companion/archive/refs/tags/v${pkgver}.tar.gz"
    "cuda-linux.patch"
    "photocraft-companion.sh"
)
sha256sums=(
    'f6b8eba0df75f0d7488add9d27f5c0c36053187eac73a146b02349479abc932d'
    '8f562c12ef1a6da64707c39dd47b7aeaab17a32cd5bd916e44e379ef35b2f741'
    'af8bb2c1a388aa3662f7c995be0d125055c9e12b5c1bfefc44a8d651e120fc4d'
)

prepare() {
    cd "${pkgname}-${pkgver}"
    patch -Np1 -i "${srcdir}/cuda-linux.patch"
}

build() {
    cd "${pkgname}-${pkgver}"
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export CFLAGS="${CFLAGS//-flto/}"
    export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
    export CXXFLAGS="${CXXFLAGS//-flto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"
    export LDFLAGS="${LDFLAGS//-flto/}"
    cargo build --release --locked
}

package() {
    cd "${pkgname}-${pkgver}"

    # 1. Main executable under /usr/lib/photocraft-companion/
    install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/lib/${pkgname}/${pkgname}"

    # 2. Bundled ONNX Runtime provider shared libraries
    local ort_provider_so
    ort_provider_so="$(find "${XDG_CACHE_HOME:-$HOME/.cache}" "target/release" -name "libonnxruntime_providers_cuda.so" 2>/dev/null | head -n1 || true)"
    if [[ -n "${ort_provider_so}" ]]; then
        local ort_dir
        ort_dir="$(dirname "${ort_provider_so}")"
        install -Dm755 "${ort_dir}"/libonnxruntime_providers_*.so -t "${pkgdir}/usr/lib/${pkgname}/"
    fi

    # 3. Environment wrapper in /usr/bin/
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"

    # 4. Plugins and registry in /usr/share/photocraft-companion/
    install -d "${pkgdir}/usr/share/${pkgname}"
    cp -r plugins "${pkgdir}/usr/share/${pkgname}/"
    install -Dm644 web/public/registry.json "${pkgdir}/usr/share/${pkgname}/registry.json"

    # 5. Symlink plugins adjacent to binary for portable/exe-relative discovery
    ln -s "/usr/share/${pkgname}/plugins" "${pkgdir}/usr/lib/${pkgname}/plugins"

    # 6. Desktop integration and icon
    install -Dm644 packaging/linux/photocraft-companion.desktop "${pkgdir}/usr/share/applications/photocraft-companion.desktop"
    install -Dm644 assets/icon.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/photocraft-companion.svg"
}
