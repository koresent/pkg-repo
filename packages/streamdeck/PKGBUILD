# Maintainer: koresent <https://github.com/koresent>
pkgname=streamdeck
pkgver=0.1.0.r5.ge116c07
pkgrel=1
pkgdesc="Wayland-native Stream Deck service and GUI"
arch=('x86_64')
url="https://github.com/koresent/streamdeck"
license=('MIT')
depends=('glibc' 'gcc-libs' 'hidapi')
provides=('streamdeck')
conflicts=('streamdeck-bin' 'streamdeck-git' 'streamdeck-gui')
source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/koresent/streamdeck/releases/download/nightly/streamdeck-x86_64-unknown-linux-gnu.tar.gz"
    "streamdeck.desktop"
    "streamdeck.png"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    install -Dm755 "${srcdir}/streamdeck" "${pkgdir}/usr/bin/streamdeck"
    install -Dm644 "${srcdir}/streamdeck.desktop" "${pkgdir}/usr/share/applications/streamdeck.desktop"
    install -Dm644 "${srcdir}/streamdeck.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/streamdeck.png"
    if [[ -f "${srcdir}/LICENSE" ]]; then
        install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
