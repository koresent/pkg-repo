[Desktop Entry]
Name=kshot
GenericName=Screenshot tool
Comment=Wayland screenshot and annotation tool
Exec=/usr/bin/kshot gui
Icon=kshot
Terminal=false
Type=Application
Categories=Utility;Graphics;
StartupNotify=false
Keywords=kshot;screenshot;capture;flameshot;
Actions=Capture;Screen;Area;

[Desktop Action Capture]
Name=Take screenshot (GUI)
Exec=/usr/bin/kshot gui

[Desktop Action Screen]
Name=Capture full screen
Exec=/usr/bin/kshot screen -c

[Desktop Action Area]
Name=Capture area
Exec=/usr/bin/kshot area -c
