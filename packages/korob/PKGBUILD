# Maintainer: koresent <https://github.com/koresent>
pkgname=korob
pkgver=0.1.0.r3.g8cb2760
pkgrel=1
pkgdesc="Wayland Hotkey & Cheatsheet Overlay"
arch=('x86_64')
url="https://github.com/koresent/korob"
license=('GPL3')
depends=('glibc' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1')
provides=('korob')
conflicts=('korob-bin' 'korob-git')
source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/koresent/korob/releases/download/nightly/korob-x86_64-unknown-linux-gnu.tar.gz"
    "korob.desktop"
    "korob-128.png"
    "korob-256.png"
    "korob-512.png"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    install -Dm755 "${srcdir}/korob" "${pkgdir}/usr/bin/korob"
    install -Dm644 "${srcdir}/korob.desktop" "${pkgdir}/usr/share/applications/korob.desktop"
    install -Dm644 "${srcdir}/korob-128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/korob.png"
    install -Dm644 "${srcdir}/korob-256.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/korob.png"
    install -Dm644 "${srcdir}/korob-512.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/korob.png"
    if [[ -f "${srcdir}/LICENSE" ]]; then
        install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
