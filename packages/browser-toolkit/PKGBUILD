# Maintainer: koresent <https://github.com/koresent>
pkgname=browser-toolkit
pkgver=0.1.0.r34.gcbd511e
pkgrel=1
pkgdesc="Auditing, testing, and fixing toolkit for UserStyles and UserScripts using Zen Browser profile"
arch=('any')
url="https://github.com/koresent/browser-toolkit"
license=('GPL3')
depends=('python' 'snappy')
makedepends=('git' 'uv' 'snappy')
provides=('browser-toolkit')
source=(
    "${pkgname}::git+https://github.com/koresent/browser-toolkit.git#branch=main"
)
sha256sums=(
    'SKIP'
)

package() {
    cd "${srcdir}/browser-toolkit"
    local venv_dir="${pkgdir}/usr/lib/${pkgname}"
    uv venv --python /usr/bin/python "${venv_dir}"
    uv pip install --python "${venv_dir}/bin/python" .

    if [[ -d "${venv_dir}/bin" ]]; then
        sed -i "s|${pkgdir}||g" "${venv_dir}/bin/"* 2>/dev/null || true
    fi

    install -d "${pkgdir}/usr/bin"
    cat << 'EOF' > "${pkgdir}/usr/bin/browser-toolkit"
#!/bin/sh
exec /usr/lib/browser-toolkit/bin/python -m browser_toolkit.cli "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/browser-toolkit"
    ln -s browser-toolkit "${pkgdir}/usr/bin/browser-auditor"

    if [[ -f LICENSE ]]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
